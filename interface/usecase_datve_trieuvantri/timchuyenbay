<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust - Đặt Vé Máy Bay Cổ Điển</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Quicksand:wght@400..700&display=swap" rel="stylesheet">
    
    <style>
        /* --- Bảng Màu Chủ Đạo Nâu & Vintage Style --- */
        :root {
            --primary-dark: #4A3525;    /* Nâu đậm cổ điển */
            --primary-medium: #8C6239;  /* Nâu đất chủ đạo */
            --primary-light: #C6A17B;   /* Nâu sáng/vàng cát */
            --bg-cream: #F4EFE6;        /* Nền giấy cũ, ấm áp */
            --bg-card: #FFFFFF;         /* Trắng thuần cho vùng nhập liệu */
            --text-dark: #2B1D11;       /* Màu chữ nâu đen mộc mạc */
            --text-muted: #6E5D4F;      /* Chữ ghi chú nhẹ */
            --border-color: #D3C2B0;    /* Viền mỏng màu cát */
            --accent-green: #556B2F;    /* Xanh rêu điểm xuyết hoài niệm */
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Quicksand', sans-serif;
        }

        body {
            background-color: var(--bg-cream);
            color: var(--text-dark);
            line-height: 1.6;
            background-image: radial-gradient(rgba(140, 98, 57, 0.04) 1px, transparent 0);
            background-size: 20px 20px;
        }

        h1, h2, h3, .vintage-title {
            font-family: 'Playfair Display', serif;
            color: var(--primary-dark);
            font-weight: 700;
        }

        /* --- Thanh điều hướng (Navigation Bar) --- */
        header {
            background-color: var(--primary-dark);
            color: var(--bg-cream);
            padding: 1.2rem 2rem;
            border-bottom: 4px double var(--primary-light);
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .header-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo h1 {
            color: var(--bg-cream);
            font-size: 1.6rem;
            letter-spacing: 2px;
            font-style: italic;
        }

        .logo span {
            font-size: 0.75rem;
            display: block;
            font-family: 'Quicksand', sans-serif;
            text-transform: uppercase;
            color: var(--primary-light);
            letter-spacing: 1px;
        }

        nav a {
            color: var(--bg-cream);
            text-decoration: none;
            margin-left: 1.5rem;
            font-size: 0.95rem;
            font-weight: 600;
            transition: all 0.3s;
            border-bottom: 1px solid transparent;
            padding-bottom: 3px;
        }

        nav a:hover, nav a.active {
            color: var(--primary-light);
            border-bottom: 1px solid var(--primary-light);
        }

        .user-profile {
            font-size: 0.9rem;
            border-left: 1px solid var(--primary-medium);
            padding-left: 1rem;
            color: var(--primary-light);
        }

        /* --- Khung Nội dung chính --- */
        .container {
            max-width: 1100px;
            margin: 2.5rem auto;
            padding: 0 1.5rem;
        }

        /* --- Tiến trình các bước (Steps Indicator) --- */
        .steps-bar {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2.5rem;
            position: relative;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .steps-bar::before {
            content: '';
            position: absolute;
            top: 22px; left: 0; right: 0;
            height: 2px;
            background-color: var(--border-color);
            z-index: 1;
        }

        .step {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
        }

        .step-number {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background-color: #EFE9DE;
            border: 2px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: var(--text-muted);
            transition: all 0.3s;
        }

        .step.active .step-number {
            background-color: var(--primary-medium);
            border-color: var(--primary-dark);
            color: #fff;
            box-shadow: 0 0 0 5px rgba(140, 98, 57, 0.15);
        }

        .step-label {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        .step.active .step-label {
            color: var(--primary-dark);
        }

        /* --- Khung form chính (Vintage Card) --- */
        .vintage-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 2.5rem;
            box-shadow: 0 12px 30px rgba(74, 53, 37, 0.04);
            position: relative;
        }

        /* Viền kẻ đứt trang trí bên trong theo style bưu thiếp cổ xưa */
        .vintage-card::before {
            content: '';
            position: absolute;
            top: 8px; left: 8px; right: 8px; bottom: 8px;
            border: 1px dashed rgba(140, 98, 57, 0.25);
            pointer-events: none;
            border-radius: 2px;
        }

        .section-title {
            font-size: 1.6rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* Chọn loại vé (RN-1) */
        .radio-container {
            display: flex;
            gap: 2rem;
            margin-bottom: 1.8rem;
        }

        .radio-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .radio-label input[type="radio"] {
            accent-color: var(--primary-medium);
            width: 16px;
            height: 16px;
        }

        /* Grid layout cho form tìm kiếm */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .form-group label {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--primary-dark);
            letter-spacing: 0.5px;
        }

        .form-group input, .form-group select {
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: 3px;
            background-color: #FCFAF7;
            color: var(--text-dark);
            font-size: 0.95rem;
            outline: none;
            transition: all 0.3s;
        }

        .form-group input:focus, .form-group select:focus {
            border-color: var(--primary-medium);
            background-color: #fff;
            box-shadow: 0 0 0 3px rgba(140, 98, 57, 0.1);
        }

        /* Ô nhập mã giảm giá (FR-03.5) */
        .coupon-group {
            max-width: 300px;
            margin-top: 1rem;
            border-top: 1px dashed var(--border-color);
            padding-top: 1.5rem;
        }

        /* Khu vực Nút bấm */
        .actions-container {
            display: flex;
            justify-content: flex-end;
            margin-top: 2.5rem;
        }

        .btn-vintage {
            background-color: var(--primary-medium);
            color: #fff;
            border: none;
            padding: 0.9rem 2.8rem;
            font-size: 1.05rem;
            font-weight: 600;
            border-radius: 2px;
            cursor: pointer;
            transition: all 0.3s;
            font-family: 'Playfair Display', serif;
            box-shadow: 0 4px 8px rgba(74, 53, 37, 0.15);
            letter-spacing: 0.5px;
        }

        .btn-vintage:hover {
            background-color: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 6px 12px rgba(74, 53, 37, 0.25);
        }

        /* --- Bảng chân trang (Footer) --- */
        footer {
            text-align: center;
            padding: 3rem 1rem;
            margin-top: 5rem;
            border-top: 1px dashed var(--border-color);
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        /* Hỗ trợ Responsive di động */
        @media (max-width: 768px) {
            .header-container {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
            nav {
                margin: 0.5rem 0;
            }
            nav a {
                margin: 0 0.6rem;
            }
            .vintage-card {
                padding: 1.5rem;
            }
            .steps-bar {
                display: none; /* Ẩn bớt thanh tiến trình trên mobile nhỏ */
            }
        }
    </style>
</head>
<body>

    <header>
        <div class="header-container">
            <div class="logo">
                <h1>Wanderlust</h1>
                <span>Hệ Thống Hỗ Trợ Du Lịch</span>
            </div>
            <nav>
                <a href="#trangchu">Trang chủ</a>
                <a href="#diadiem">Tìm kiếm địa điểm</a>
                <a href="#kehoach">Lập kế hoạch</a>
                <a href="#datve" class="active">Đặt vé máy bay</a>
                <a href="#datphong">Đặt phòng</a>
            </nav>
            <div class="user-profile">
                Chào, <strong>Lữ khách phương xa</strong>
            </div>
        </div>
    </header>

    <main class="container">
        
        <div class="steps-bar">
            <div class="step active">
                <div class="step-number">1</div>
                <div class="step-label">Tìm chuyến bay</div>
            </div>
            <div class="step">
                <div class="step-number">2</div>
                <div class="step-label">Chọn chuyến</div>
            </div>
            <div class="step">
                <div class="step-number">3</div>
                <div class="step-label">Thông tin & Ghế</div>
            </div>
            <div class="step">
                <div class="step-number">4</div>
                <div class="step-label">Thanh toán</div>
            </div>
        </div>

        <div class="vintage-card">
            <h2 class="section-title">✈ Tra Cứu Chuyến Bay Khởi Hành</h2>
            
            <form action="#" method="POST" onsubmit="event.preventDefault(); alert('Đang kết nối API hệ thống Hãng hàng không để truy xuất dữ liệu thời gian thực...');">
                
                <div class="radio-container">
                    <label class="radio-label">
                        <input type="radio" name="flight-type" value="one-way" checked onclick="toggleReturnDate(false)">
                        Một chiều
                    </label>
                    <label class="radio-label">
                        <input type="radio" name="flight-type" value="round-trip" onclick="toggleReturnDate(true)">
                        Khứ hồi (RN-1)
                    </label>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label for="departure-city">Điểm đi</label>
                        <select id="departure-city" required>
                            <option value="">-- Chọn điểm đi --</option>
                            <option value="HAN">Hà Nội (HAN)</option>
                            <option value="SGN">TP. Hồ Chí Minh (SGN)</option>
                            <option value="DAD">Đà Nẵng (DAD)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="arrival-city">Điểm đến</label>
                        <select id="arrival-city" required>
                            <option value="">-- Chọn điểm đến --</option>
                            <option value="SGN">TP. Hồ Chí Minh (SGN)</option>
                            <option value="HAN">Hà Nội (HAN)</option>
                            <option value="DAD">Đà Nẵng (DAD)</option>
                            <option value="PQC">Phú Quốc (PQC)</option>
                        </select>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label for="depart-date">Ngày khởi hành</label>
                        <input type="date" id="depart-date" required>
                    </div>
                    <div class="form-group" id="return-date-container" style="opacity: 0.4; pointer-events: none;">
                        <label for="return-date">Ngày về</label>
                        <input type="date" id="return-date">
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label for="passenger-count">Số hành khách</label>
                        <input type="number" id="passenger-count" min="1" max="9" value="1" required>
                    </div>
                    <div class="form-group">
                        <label for="cabin-class">Hạng ghế vé</label>
                        <select id="cabin-class" required>
                            <option value="economy">Phổ thông</option>
                            <option value="business">Thương gia</option>
                            <option value="first">Hạng nhất (First Class)</option>
                        </select>
                    </div>
                </div>

                <div class="coupon-group">
                    <div class="form-group">
                        <label for="coupon-code">Mã khuyến mãi (Nếu có)</label>
                        <input type="text" id="coupon-code" placeholder="Ví dụ: VINTAGE2026">
                    </div>
                </div>

                <div class="actions-container">
                    <button type="submit" class="btn-vintage">Tìm chuyến bay tương thích ➔</button>
                </div>

            </form>
        </div>
    </main>

    <footer>
        <p>© 2026 Wanderlust Travel. Toàn bộ luồng giao tiếp dữ liệu được mã hóa bảo mật qua giao thức HTTPS/TLS.</p>
        <p style="margin-top: 0.4rem; font-size: 0.75rem; opacity: 0.6;">Hệ thống giữ chỗ tự động tối đa 15 phút trước khi hoàn trả trạng thái trống.</p>
    </footer>

    <script>
        function toggleReturnDate(isRoundTrip) {
            const container = document.getElementById('return-date-container');
            const input = document.getElementById('return-date');
            
            if (isRoundTrip) {
                container.style.opacity = '1';
                container.style.pointerEvents = 'auto';
                input.setAttribute('required', 'required');
            } else {
                container.style.opacity = '0.4';
                container.style.pointerEvents = 'none';
                input.removeAttribute('required');
                input.value = '';
            }
        }
    </script>
</body>
</html>
